APP_NAME=SecureCampus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en_US
APP_FALLBACK_LOCALE=en_US

LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=securecampus
DB_USERNAME=securecampus
DB_PASSWORD=securecampus
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Optional account creation when running php artisan db:seed.
# Set both values explicitly; passwords must contain at least 12 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
